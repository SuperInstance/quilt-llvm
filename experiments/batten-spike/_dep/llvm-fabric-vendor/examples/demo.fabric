; demo.fabric — diamond control flow with a phi wire-join.
; Try:
;   llvm-fabric verify examples/demo.fabric
;   llvm-fabric prov examples/demo.fabric 9
;   llvm-fabric pipeline examples/demo.fabric
;   llvm-fabric replay examples/demo.fabric
fabric v0
region entry
  %0 = param i32
  %1 = const i32 42
  %2 = arith.add i32 %0, %1
  %3 = cmp.lt %2, %1
  %5 = br %3, then, else
region then
  %4 = const i64 1i64
  %6 = jump join
region else
  %7 = const i64 2i64
  %8 = jump join
region join
  %9 = phi [then: %4] [else: %7]
  %10 = ret %9
